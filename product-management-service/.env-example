# MongoDB Connection Mode
# Set to true for URI-based (cloud), false for host/port/credentials
IS_CLOUD_DB=false

# Option 1: URI-based connection (when IS_CLOUD_DB=true)
MONGODB_URI=mongodb+srv://<db_user>:<password>@cluster0.mongodb.net/product_management_db?retryWrites=true&w=majority

# Option 2: Host/Port/Credentials (when IS_CLOUD_DB=false)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=product_management_db
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_DB=admin

# JWT (must match User Management Service)
JWT_SECRET=
JWT_EXPIRATION=86400000